{
  "ir_version": "1.0",
  "domain": "compose",
  "name": "safety_env",
  "nodes": [
    {
      "id": "gen",
      "kind": "tool",
      "tool": "test_generator",
      "in_type": { "type": "object", "required": ["spec"] },
      "out_type": { "type": "object", "required": ["tests"] },
      "config": { "api_key": "${DEEPSEEK_API_KEY}" }
    },
    {
      "id": "g_bounds",
      "kind": "guard",
      "expr": "spec.n_min >= 1 && spec.n_max <= 100000",
      "on_fail": "reject"
    },
    {
      "id": "hook",
      "kind": "notify",
      "config": { "url": "http://127.0.0.1/internal-hook" }
    },
    {
      "id": "review",
      "kind": "human_gate",
      "assignee_role": "problemsetter",
      "on_fail": "reject"
    },
    {
      "id": "pub",
      "kind": "tool",
      "tool": "publish_problem"
    }
  ],
  "edges": [
    { "from": "gen", "to": "g_bounds" },
    { "from": "g_bounds", "to": "hook" },
    { "from": "hook", "to": "review" },
    { "from": "review", "to": "pub" }
  ]
}
