[Unit]
Description=Veriflow API
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/veriflow
EnvironmentFile=/opt/veriflow/.env
ExecStart=/opt/veriflow/.venv/bin/uvicorn veriflow_api.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
